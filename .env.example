# Copy to .env. Used by `pheme-report build` and `pheme-report serve`. Never commit real credentials.

# Empty values fall back to the standard AWS chain (AWS_REGION, AWS_PROFILE, env keys, SSO, role).
PHEME_AWS_REGION=
PHEME_AWS_PROFILE=
# Optional Bedrock API key; empty signs requests with your AWS credentials (SigV4).
PHEME_BEDROCK_API_KEY=

# Bedrock model id (with the "anthropic." prefix) and reasoning effort (low | medium | high).
PHEME_MODEL=anthropic.claude-opus-5-5
PHEME_EFFORT=medium

# Which verdict labels count as passed and failed in the report totals (comma separated).
# Any other verdict is counted as "other". These are the defaults.
PHEME_PASS_VERDICTS=PASS,PASSED,MATCH,EXACT,OK,CLOSE
PHEME_FAIL_VERDICTS=MISMATCH,FAIL,FAILED,ERROR,TIMEOUT
